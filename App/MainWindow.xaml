<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="MainWindow" Title="CT QA Manager Pro" Width="1280" Height="850" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterScreen" Background="#0B1120" Foreground="#EAF0FC" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">

 <Window.Icon><DrawingImage><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="#103342" Geometry="M0,0 L48,0 48,48 0,48 Z"/><GeometryDrawing Geometry="M7,24 L16,24 21,10 27,38 32,24 41,24"><GeometryDrawing.Pen><Pen Brush="#41E2CF" Thickness="3" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage></Window.Icon>
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#91A3BF"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EAF0FC"/><Setter Property="Background" Value="#1A2B43"/><Setter Property="BorderBrush" Value="#2A405C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#70EBDF"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="17,14"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#141F32"/><Setter Property="BorderBrush" Value="#24334C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="22"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0E192B"/><Setter Property="Foreground" Value="#EDF4FF"/><Setter Property="CaretBrush" Value="#33D6C5"/><Setter Property="BorderBrush" Value="#30435F"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#142139"/><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="34"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D3DEEF"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,7"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#101B2E"/><Setter Property="Foreground" Value="#E0E8F6"/><Setter Property="BorderBrush" Value="#283A55"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#23324B"/><Setter Property="RowBackground" Value="#141F32"/><Setter Property="AlternatingRowBackground" Value="#18253B"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="RowHeight" Value="40"/><Setter Property="ColumnHeaderHeight" Value="39"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#1D2D46"/><Setter Property="Foreground" Value="#A9BDD7"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,4"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#244568"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#EDF4FF"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,9"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1C3E59"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#0D1729" BorderBrush="#1F2D44" BorderThickness="0,0,1,0">
   <Grid Margin="17,29,17,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="12,0,0,38"><Border Width="43" Height="43" HorizontalAlignment="Left" CornerRadius="12" Background="#123D48" Margin="0,0,0,14"><Grid><Path Data="M 8,20 L 16,20 20,8 25,32 29,20 36,20" Stroke="#43E6D5" StrokeThickness="2.5" Stretch="Uniform" Margin="8"/></Grid></Border><TextBlock Text="CT QA" FontWeight="Bold" FontSize="25"/><TextBlock Text="MANAGER PRO" Foreground="#76A2BF" FontSize="10" Margin="1,5,0,0"/></StackPanel>
    <StackPanel Grid.Row="1"><Button x:Name="DashboardNav" Style="{StaticResource NavButton}" Background="#153443"><TextBlock Text="Dashboard" FontWeight="SemiBold"/></Button><Button x:Name="ReportsNav" Style="{StaticResource NavButton}" Content="Reports &amp; exports"/><Button x:Name="AdvancedNav" Style="{StaticResource NavButton}" Content="Advanced settings"/></StackPanel>
    <StackPanel Grid.Row="3" Margin="12,10,12,0"><Border Height="1" Background="#24334B" Margin="0,0,0,17"/><TextBlock Text="YOUR ARCHIVE, ORGANIZED" Foreground="#617F9F" FontSize="9"/><TextBlock Text="Local files. Clear records." Foreground="#8EA5C0" FontSize="11" Margin="0,8,0,0"/><Button x:Name="HelpButton" Content="How to use  /  F1" Margin="0,12,0,0" Padding="8,8" Background="#152840" FontSize="11"/><TextBlock Text="Version 4.2.1" Foreground="#617F9F" FontSize="10" Margin="0,8,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="30,25,30,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,23"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageEyebrow" Text="DEPARTMENT WORKSPACE" Foreground="#6D92B3" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="PageTitle" Text="Today at a glance" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,5"/><TextBlock x:Name="PageSubtitle" Text="A clear view of your scanner reports and archive." Foreground="{StaticResource Muted}"/></StackPanel><Border Grid.Column="1" VerticalAlignment="Top" Background="#112F35" CornerRadius="16" Padding="12,8" Margin="12,3,0,0"><StackPanel Orientation="Horizontal"><Ellipse Fill="#33D6C5" Width="6" Height="6" Margin="0,0,7,0"/><TextBlock Text="PORTABLE WORKSPACE" Foreground="#75D9CE" FontSize="9" FontWeight="SemiBold"/></StackPanel></Border></Grid>
   <Grid Grid.Row="1">
    <ScrollViewer x:Name="DashboardView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <Border Background="#123F49" BorderBrush="#267C80" BorderThickness="1" CornerRadius="18" Padding="25" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="TodayDate" Text="TODAY" Foreground="#8FE6D4" FontSize="11"/><TextBlock x:Name="TodayHeadline" Text="Your daily QA, at a glance" FontSize="27" FontWeight="SemiBold" Margin="0,9,12,8"/><TextBlock x:Name="WelcomeTitle" Text="Let's set up your report archive" FontSize="15"/><TextBlock x:Name="WelcomeText" Text="Connect your scanners and preview your first import." Foreground="#B8DAD9" Margin="0,6,15,0"/><TextBlock x:Name="BackgroundLabel" Text="Saved reports remain available offline." Foreground="#8FE6D4" FontSize="11" Margin="0,13,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="TotalCount" Text="0" FontSize="36" FontWeight="Light" HorizontalAlignment="Center"/><TextBlock Text="PDFs preserved" Foreground="#AAD6D3" FontSize="11"/></StackPanel></Grid></Border>
      <WrapPanel Margin="0,0,0,18"><Button x:Name="UpdateButton" Content="Update reports" Background="#2674DE" BorderBrush="#4A91F1" Margin="0,0,10,10"/><Button x:Name="OpenFolderButton" Content="Open report folders" Margin="0,0,10,10"/><Button x:Name="OpenNavigatorButton" Content="Open offline library" Margin="0,0,10,10"/><Button x:Name="SetupButton" HorizontalContentAlignment="Left" Margin="0,0,10,10"><StackPanel><TextBlock x:Name="SetupButtonTitle" Text="First-Time Setup"/><TextBlock x:Name="SetupButtonHint" Text="Preview and organize" FontSize="10" Foreground="#AFC5DB"/></StackPanel></Button></WrapPanel>
      <Grid Margin="0,0,0,10"><TextBlock Text="TODAY'S DAILY REPORTS" Foreground="#91B0CB" FontSize="11" FontWeight="SemiBold"/><Button x:Name="OpenTodayButton" Content="Open selected report" HorizontalAlignment="Right" Padding="10,5" FontSize="10"/></Grid>
      <DataGrid x:Name="TodayGrid" ScrollViewer.HorizontalScrollBarVisibility="Auto" Height="180" Margin="0,0,0,8"><DataGrid.Columns><DataGridTextColumn Header="Scanner" Binding="{Binding Name}" Width="150"/><DataGridTextColumn Header="Report receipt" Binding="{Binding DailyStatus}" Width="150"/><DataGridTextColumn Header="Extracted findings" Binding="{Binding Findings}" Width="*" MinWidth="280"/></DataGrid.Columns></DataGrid>
      <TextBlock Text="Receipt tracks saved PDFs. Printed results and reviewed QA evidence are assessed separately." Foreground="#91A8C1" FontSize="11" Margin="0,0,0,22"/>
      <TextBlock Text="THIS MONTH / REVIEWED EVIDENCE" Foreground="#91B0CB" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <DataGrid x:Name="MonthlyGrid" ScrollViewer.HorizontalScrollBarVisibility="Auto" Height="180" Margin="0,0,0,20"><DataGrid.Columns><DataGridTextColumn Header="Scanner" Binding="{Binding Name}" Width="150"/><DataGridTextColumn Header="Checklist" Binding="{Binding Progress}" Width="95"/><DataGridTextColumn Header="Due" Binding="{Binding Due}" Width="115"/><DataGridTextColumn Header="Reminder" Binding="{Binding Timing}" Width="140"/><DataGridTextColumn Header="Evidence needed" Binding="{Binding Detail}" Width="*" MinWidth="260"/></DataGrid.Columns></DataGrid>
      <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,20"><StackPanel><TextBlock Text="Protect and understand your archive" FontSize="16" FontWeight="SemiBold"/><WrapPanel Margin="0,13,0,0"><Button x:Name="AnalyzeButton" Content="Analyze saved PDFs" Margin="0,0,8,8" Padding="12,8"/><Button x:Name="CompatibilityButton" Content="Check this computer" Margin="0,0,8,8" Padding="12,8"/><Button x:Name="BackupButton" Content="Create full backup" Margin="0,0,8,8" Padding="12,8"/><Button x:Name="RestoreButton" Content="Restore to new folder" Margin="0,0,8,8" Padding="12,8"/><Button x:Name="SourceAuditButton" Content="Verify scanner source files" Margin="0,0,8,8" Padding="12,8"/><Button x:Name="RetryAnalysisButton" Content="Retry unreadable PDFs" Margin="0,0,8,8" Padding="12,8"/></WrapPanel><TextBlock x:Name="StorageLabel" Text="Storage will be checked before large copies." Foreground="#91AAC3" FontSize="11"/></StackPanel></Border>
      <ItemsControl x:Name="ScannerCards" Margin="0,0,-10,18"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Width="248" Padding="16" Margin="0,0,10,10"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColor}" Margin="0,8,0,5"/><TextBlock Text="{Binding UpdatedLabel}" Foreground="#9BB1C9" FontSize="11"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Border Style="{StaticResource Card}" Padding="18"><StackPanel><Grid><TextBlock Text="Needs your attention" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="AttentionCount" Foreground="#E5C27E" FontSize="11" HorizontalAlignment="Right"/></Grid><TextBlock x:Name="AttentionEmpty" Text="No findings yet." Margin="0,12,0,0" Foreground="#A0B7CE"/><ListBox x:Name="AttentionList" MaxHeight="280" Margin="0,14,0,0"><ListBox.ItemTemplate><DataTemplate><Border Background="#1B2D45" CornerRadius="9" Padding="14"><StackPanel><TextBlock Text="{Binding Message}"/><TextBlock Text="{Binding TypeLabel}" Foreground="#96B3CC" FontSize="10" Margin="0,6,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
      <StackPanel Visibility="Collapsed"><TextBlock x:Name="StepOne"/><TextBlock x:Name="StepTwo"/><TextBlock x:Name="StepThree"/></StackPanel>
     </StackPanel>
    </ScrollViewer>
    <Grid x:Name="ReportsView" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border x:Name="ReportFilters" Style="{StaticResource Card}" Padding="18,16">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="145"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Scanner" Foreground="#9DB2CC" FontSize="11" Margin="0,0,0,7"/><ComboBox x:Name="ScannerFilter" DisplayMemberPath="Label" SelectedValuePath="Value" ToolTip="Choose one scanner or all scanners"/></StackPanel>
        <StackPanel Grid.Column="2"><Grid Margin="0,0,0,7"><TextBlock Text="Year" Foreground="#9DB2CC" FontSize="11"/><Button x:Name="ChooseYearsButton" Content="Multiple..." FontSize="9" Padding="3,0" Background="Transparent" BorderThickness="0" Foreground="#71D3CA" HorizontalAlignment="Right" ToolTip="Choose several years together"/></Grid><ComboBox x:Name="YearFilter" DisplayMemberPath="Label" SelectedValuePath="Value"/></StackPanel>
        <StackPanel Grid.Column="4"><TextBlock Text="Month" Foreground="#9DB2CC" FontSize="11" Margin="0,0,0,7"/><ComboBox x:Name="MonthFilter" DisplayMemberPath="Label" SelectedValuePath="Value"/></StackPanel>
        <StackPanel Grid.Column="6"><TextBlock Text="QA type" Foreground="#9DB2CC" FontSize="11" Margin="0,0,0,7"/><ComboBox x:Name="CategoryFilter" DisplayMemberPath="Label" SelectedValuePath="Value"/></StackPanel>
       </Grid>
       <Grid Grid.Row="1" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Search within these reports" Foreground="#9DB2CC" FontSize="11" Margin="0,0,0,7"/><Grid><TextBox x:Name="ReportSearch" ToolTip="Search a report title, original filename, scanner, or date"/><TextBlock x:Name="SearchPlaceholder" Text="Type a filename, scanner, or date..." Foreground="#657E9D" Margin="11,8" IsHitTestVisible="False" VerticalAlignment="Center"/></Grid></StackPanel>
        <Button x:Name="ReviewPendingButton" Grid.Column="1" Content="Needs confirmation" ToolTip="Show reports whose type still needs confirmation. You can still export them while pending." Margin="12,19,0,0" Padding="12,9"/>
        <Button x:Name="ClearFiltersButton" Grid.Column="2" Content="Clear filters" Margin="9,19,0,0" Padding="12,9" Background="Transparent"/>
       </Grid>
      </Grid>
     </Border>
     <Grid Grid.Row="1" Margin="0,16,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,0,15,0"><TextBlock x:Name="ReportCount" Text="0 matching reports" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="FilterSummary" Text="All scanners / All years / All months / All QA types" Foreground="#89A5C5" FontSize="10" Margin="0,5,0,0"/></StackPanel>
      <Button x:Name="ExportReportsButton" Grid.Column="1" Background="#1C6670" BorderBrush="#2DA8A7" Padding="19,12"><StackPanel Orientation="Horizontal"><Path Data="M 10,1 L 10,14 M 5,9 L 10,14 15,9 M 1,15 L 1,20 19,20 19,15" Stroke="#9BF5E8" StrokeThickness="1.8" Width="19" Height="20" Stretch="Uniform" Margin="0,0,11,0"/><TextBlock x:Name="ExportButtonText" Text="Export matching reports (.zip)" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Button>
     </Grid>
     <DataGrid x:Name="ReportsGrid" Grid.Row="2" RowHeight="48"><DataGrid.Columns>
      <DataGridTemplateColumn Header="Report" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ReportTitle}" ToolTip="{Binding OriginalFileName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,6"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="Scanner" Binding="{Binding ScannerName}" Width="115"/><DataGridTextColumn Header="QA type" Binding="{Binding CategoryLabel}" Width="210"/>
     </DataGrid.Columns></DataGrid>
     <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="OpenReportButton" Content="Open selected PDF" Margin="0,0,10,0"/><Button x:Name="ReadReportTextButton" Grid.Column="1" Content="Read report text" Margin="0,0,10,0" Visibility="Collapsed"/><Button x:Name="ReviewReportButton" Grid.Column="2" Content="Check report label" ToolTip="Most reports are organized automatically. Use this only when a report type needs confirmation."/><Button x:Name="BrowseReportsButton" Grid.Column="3" Content="Browse folders" Margin="10,0,0,0"/><TextBlock Grid.Column="4" Text="Export includes every matching report, including separate sessions." Foreground="#829CBC" FontSize="10" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid>
     <Border Grid.Row="4" Background="#132B35" CornerRadius="8" Padding="12,10" Margin="0,13,0,0" x:Name="ExportResultPanel" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ExportResultText" Foreground="#A9DFD7" FontSize="11" VerticalAlignment="Center"/><Button x:Name="OpenExportFolderButton" Grid.Column="1" Content="Open export folder" Padding="11,6" Margin="12,0,0,0" Background="#204C54" Visibility="Collapsed"/></Grid></Border>
    </Grid>
    <ScrollViewer x:Name="AdvancedView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Style="{StaticResource Card}" Margin="0,0,0,17"><StackPanel><TextBlock Text="Archive destination" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="The selected location contains your Reports folder, master index, and activity history. Changing it never moves or deletes existing files." Foreground="#8FA8C4" Margin="0,8,0,14"/><CheckBox x:Name="AutoUpdateOnOpen" Content="Check for new reports once when this app opens" Margin="0,0,0,5"/><TextBlock Text="After first-time setup. No repeated schedule; nothing runs after the app closes." Foreground="#729CB8" FontSize="10" Margin="0,0,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ArchivePath"/><Button x:Name="BrowseArchiveButton" Grid.Column="1" Content="Choose folder" Margin="10,0,0,0"/></Grid><StackPanel Orientation="Horizontal" Margin="0,13,0,0"><Button x:Name="AdoptLegacyButton" Content="Reuse existing v2/v3 archive" Margin="0,0,10,0"/><Button x:Name="OpenLogsButton" Content="Open activity and diagnostics"/></StackPanel></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,17"><StackPanel><TextBlock Text="Scanner connections and classification" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="UNC folders are used directly. Reconnect uses a secure credential prompt only when needed and preserves unrelated drive mappings. Thresholds identify candidates; they never confirm Monthly QA." Foreground="#8FA8C4" Margin="0,8,0,17"/><WrapPanel Margin="0,10,0,18"><StackPanel Width="180" Margin="0,0,14,0"><TextBlock Text="Check interval (minutes, 0 = off)"/><TextBox x:Name="MonitorMinutes"/></StackPanel><CheckBox x:Name="AutoAnalyze" Content="Analyze new saved PDFs locally"/></WrapPanel><StackPanel x:Name="ScannerSettingsPanel"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Button x:Name="ImportConnectionsButton" Content="Apply local connection profile" HorizontalAlignment="Left" Margin="0,7,0,0"/><Button x:Name="ReconnectButton" Content="Reconnect drives" Margin="0,0,10,0"/><Button x:Name="AddScannerButton" Content="Add scanner" Background="#1B4A58"/></StackPanel></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,17"><StackPanel><TextBlock Text="Coverage and integrity" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Coverage is based on your archive and expected schedule, through yesterday and completed months. Adjust each scanner's active-from date to avoid reporting periods before service began." Foreground="#8FA8C4" Margin="0,8,0,14"/><WrapPanel><StackPanel Width="180" Margin="0,0,18,10"><TextBlock Text="Daily lookback (days)" Foreground="#9BB1CB" Margin="0,0,0,7"/><TextBox x:Name="DailyLookback"/></StackPanel><StackPanel Width="180" Margin="0,0,18,10"><TextBlock Text="Monthly lookback (months)" Foreground="#9BB1CB" Margin="0,0,0,7"/><TextBox x:Name="MonthlyLookback"/></StackPanel><StackPanel Width="180" Margin="0,0,0,10"><TextBlock Text="Minimum PDF age (seconds)" Foreground="#9BB1CB" Margin="0,0,0,7"/><TextBox x:Name="MinimumAge"/></StackPanel></WrapPanel><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><Button x:Name="AuditButton" Content="Run full integrity audit" Margin="0,0,10,0"/><Button x:Name="ReclassifyButton" Content="Review classification overrides"/></StackPanel></StackPanel></Border>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,19"><Button x:Name="SaveSettingsButton" Content="Save advanced settings" Background="#1B5D68" BorderBrush="#2B9B9E" Margin="0,0,12,0"/><TextBlock Text="Settings apply when you open the app again or start the next operation." Foreground="#8CA4C2" VerticalAlignment="Center"/></StackPanel>
     <TextBlock Text="CT QA Manager Pro 4.2.1   |   Windows PowerShell 5.1 + native WPF" Foreground="#7090B1" FontSize="11"/><TextBlock Text="Optional periodic checks run only while this window is open. Saved sign-ins are encrypted. Original scanner reports are always read-only. Use under your department's approved access and records policy." Foreground="#7090B1" FontSize="11" Margin="0,6,0,15"/>
    </StackPanel></ScrollViewer>
   </Grid>
   <Border Grid.Row="2" Background="#101B2D" BorderBrush="#22334B" BorderThickness="1" CornerRadius="10" Padding="15,11" Margin="0,17,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Ready. Choose First-Time Setup to begin." Foreground="#9FB4CF" VerticalAlignment="Center" FontSize="11"/><Button x:Name="CancelButton" Grid.Column="1" Content="Cancel safely" Visibility="Collapsed" Padding="11,5" Margin="12,0,0,0"/></Grid><ProgressBar x:Name="WorkProgress" Grid.Row="1" Visibility="Collapsed" Height="3" Margin="0,10,0,0" Minimum="0" Maximum="100" Foreground="#33D6C5" Background="#20334C" BorderThickness="0"/></Grid></Border>
  </Grid>
 </Grid>
</Window>
