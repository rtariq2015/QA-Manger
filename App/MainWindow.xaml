<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="MainWindow" Title="CT QA Manager Pro" Width="1280" Height="850" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterScreen" Background="#0B1120" Foreground="#EAF0FC" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">

 <Window.Icon><DrawingImage><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="#103342" Geometry="M0,0 L48,0 48,48 0,48 Z"/><GeometryDrawing Geometry="M7,24 L16,24 21,10 27,38 32,24 41,24"><GeometryDrawing.Pen><Pen Brush="#41E2CF" Thickness="3" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage></Window.Icon>
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#91A3BF"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EAF0FC"/><Setter Property="Background" Value="#1A2B43"/><Setter Property="BorderBrush" Value="#2A405C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#70EBDF"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="17,14"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#141F32"/><Setter Property="BorderBrush" Value="#24334C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="22"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0E192B"/><Setter Property="Foreground" Value="#EDF4FF"/><Setter Property="CaretBrush" Value="#33D6C5"/><Setter Property="BorderBrush" Value="#30435F"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#142139"/><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="34"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D3DEEF"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,7"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#101B2E"/><Setter Property="Foreground" Value="#E0E8F6"/><Setter Property="BorderBrush" Value="#283A55"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#23324B"/><Setter Property="RowBackground" Value="#141F32"/><Setter Property="AlternatingRowBackground" Value="#18253B"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="RowHeight" Value="40"/><Setter Property="ColumnHeaderHeight" Value="39"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#1D2D46"/><Setter Property="Foreground" Value="#A9BDD7"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,4"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#244568"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#EDF4FF"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,9"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1C3E59"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#0D1729" BorderBrush="#1F2D44" BorderThickness="0,0,1,0">
   <Grid Margin="17,29,17,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="12,0,0,38"><Border Width="43" Height="43" HorizontalAlignment="Left" CornerRadius="12" Background="#123D48" Margin="0,0,0,14"><Grid><Path Data="M 8,20 L 16,20 20,8 25,32 29,20 36,20" Stroke="#43E6D5" StrokeThickness="2.5" Stretch="Uniform" Margin="8"/></Grid></Border><TextBlock Text="CT QA" FontWeight="Bold" FontSize="25"/><TextBlock Text="MANAGER PRO" Foreground="#76A2BF" FontSize="10" Margin="1,5,0,0"/></StackPanel>
    <StackPanel Grid.Row="1"><Button x:Name="DashboardNav" Style="{StaticResource NavButton}" Background="#153443"><TextBlock Text="Dashboard" FontWeight="SemiBold"/></Button><Button x:Name="ReportsNav" Style="{StaticResource NavButton}" Content="Report library"/><Button x:Name="AdvancedNav" Style="{StaticResource NavButton}" Content="Advanced settings"/></StackPanel>
    <StackPanel Grid.Row="3" Margin="12,10,12,0"><Border Height="1" Background="#24334B" Margin="0,0,0,17"/><TextBlock Text="YOUR ARCHIVE, ORGANIZED" Foreground="#617F9F" FontSize="9"/><TextBlock Text="Manual updates. Local files." Foreground="#8EA5C0" FontSize="11" Margin="0,8,0,0"/><TextBlock Text="Version 4.0.0" Foreground="#617F9F" FontSize="10" Margin="0,8,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="30,25,30,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,23"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageEyebrow" Text="DEPARTMENT WORKSPACE" Foreground="#6D92B3" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="PageTitle" Text="QA overview" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,5"/><TextBlock x:Name="PageSubtitle" Text="A clear view of your scanner reports and archive." Foreground="{StaticResource Muted}"/></StackPanel><Border Grid.Column="1" VerticalAlignment="Top" Background="#112F35" CornerRadius="16" Padding="12,8" Margin="12,3,0,0"><StackPanel Orientation="Horizontal"><Ellipse Fill="#33D6C5" Width="6" Height="6" Margin="0,0,7,0"/><TextBlock Text="PORTABLE WORKSPACE" Foreground="#75D9CE" FontSize="9" FontWeight="SemiBold"/></StackPanel></Border></Grid>
   <Grid Grid.Row="1">
    <ScrollViewer x:Name="DashboardView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <Border Background="#142A40" BorderBrush="#254861" BorderThickness="1" CornerRadius="15" Padding="23,20" Margin="0,0,0,22">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="WelcomeTitle" Text="Your first import starts here" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="WelcomeText" Text="Connect your scanners, preview the reports, then choose what to copy." Foreground="#A9BDD4" Margin="0,8,18,0" MaxWidth="620" HorizontalAlignment="Left"/></StackPanel><Border Grid.Column="1" Background="#163C4D" CornerRadius="11" Padding="15,9" VerticalAlignment="Center"><StackPanel><TextBlock x:Name="TotalCount" Text="0" Foreground="#6CE6D7" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="saved PDFs" Foreground="#8FB8C7" FontSize="10"/></StackPanel></Border></Grid>
      </Border>
      <Grid Margin="0,0,0,25"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Button x:Name="SetupButton" Background="#194854" BorderBrush="#2C7F83" Padding="19,18" HorizontalContentAlignment="Left"><StackPanel><Path Data="M 0,9 L 6,15 17,2 M 6,22 L 17,22" Stroke="#64E4D5" StrokeThickness="2.2" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,13"/><TextBlock x:Name="SetupButtonTitle" Text="First-Time Setup" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="SetupButtonHint" Text="Preview and organize" Foreground="#ADD4D8" FontSize="11" Margin="0,6,0,0"/></StackPanel></Button>
       <Button x:Name="UpdateButton" Grid.Column="2" Background="#2467C5" BorderBrush="#438CFF" Padding="19,18" HorizontalContentAlignment="Left"><StackPanel><Path Data="M 18,7 A 8,8 0 1 0 18,17 M 18,1 L 18,7 12,7" Stroke="#FFFFFF" StrokeThickness="2" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,13"/><TextBlock Text="Update Reports" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Find new and changed PDFs" Foreground="#C8E0FF" FontSize="11" Margin="0,6,0,0"/></StackPanel></Button>
       <Button x:Name="OpenFolderButton" Grid.Column="4" Background="#19283E" Padding="19,18" HorizontalContentAlignment="Left"><StackPanel><Path Data="M 1,5 L 8,5 11,8 23,8 23,22 1,22 Z M 1,9 L 23,9" Stroke="#98BCE6" StrokeThickness="1.8" Width="25" Height="22" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,13"/><TextBlock Text="Open Reports Folder" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Browse your saved archive" Foreground="#92ACC9" FontSize="11" Margin="0,6,0,0"/></StackPanel></Button>
      </Grid>
      <Grid Margin="0,0,0,12"><TextBlock Text="SCANNER STATUS" Foreground="#8AA5C2" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Status from your latest scan" Foreground="#617E9E" FontSize="10" HorizontalAlignment="Right"/></Grid>
      <Grid Margin="0,0,0,25"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="13"/><ColumnDefinition Width="*"/><ColumnDefinition Width="13"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}" Padding="18"><StackPanel><Grid><TextBlock Text="CT Edge" FontWeight="SemiBold" FontSize="15"/><Ellipse x:Name="EdgeDot" Fill="#687D99" Width="7" Height="7" HorizontalAlignment="Right"/></Grid><TextBlock x:Name="EdgeStatus" Text="Not checked" Foreground="#95AAC4" FontSize="11" Margin="0,7,0,17"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="EdgeCount" Text="0" FontSize="29" FontWeight="Light"/><TextBlock Text="reports saved" Foreground="#8AA2BF" FontSize="10" VerticalAlignment="Bottom" Margin="8,0,0,6"/></StackPanel><Border Height="1" Background="#293750" Margin="0,15,0,12"/><TextBlock x:Name="EdgeUpdated" Text="No successful update yet" FontSize="10" Foreground="#819AB7"/></StackPanel></Border>
       <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18"><StackPanel><Grid><TextBlock Text="CT Flash" FontWeight="SemiBold" FontSize="15"/><Ellipse x:Name="FlashDot" Fill="#687D99" Width="7" Height="7" HorizontalAlignment="Right"/></Grid><TextBlock x:Name="FlashStatus" Text="Not checked" Foreground="#95AAC4" FontSize="11" Margin="0,7,0,17"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="FlashCount" Text="0" FontSize="29" FontWeight="Light"/><TextBlock Text="reports saved" Foreground="#8AA2BF" FontSize="10" VerticalAlignment="Bottom" Margin="8,0,0,6"/></StackPanel><Border Height="1" Background="#293750" Margin="0,15,0,12"/><TextBlock x:Name="FlashUpdated" Text="No successful update yet" FontSize="10" Foreground="#819AB7"/></StackPanel></Border>
       <Border Grid.Column="4" Style="{StaticResource Card}" Padding="18"><StackPanel><Grid><TextBlock Text="MDP Building" FontWeight="SemiBold" FontSize="15"/><Ellipse x:Name="MdpDot" Fill="#687D99" Width="7" Height="7" HorizontalAlignment="Right"/></Grid><TextBlock x:Name="MdpStatus" Text="Not checked" Foreground="#95AAC4" FontSize="11" Margin="0,7,0,17"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="MdpCount" Text="0" FontSize="29" FontWeight="Light"/><TextBlock Text="reports saved" Foreground="#8AA2BF" FontSize="10" VerticalAlignment="Bottom" Margin="8,0,0,6"/></StackPanel><Border Height="1" Background="#293750" Margin="0,15,0,12"/><TextBlock x:Name="MdpUpdated" Text="No successful update yet" FontSize="10" Foreground="#819AB7"/></StackPanel></Border>
      </Grid>
      <Border Style="{StaticResource Card}" Padding="20,18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="QA Attention Center" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="AttentionCount" Text="Ready for your first scan" Foreground="#DDBD78" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><TextBlock Grid.Row="1" Text="Archive findings help you review records. They do not determine whether clinical QA was performed." Foreground="#8CA3BF" FontSize="11" Margin="0,8,0,16"/><TextBlock x:Name="AttentionEmpty" Grid.Row="2" Text="Run First-Time Setup to see report coverage and items needing review." Foreground="#94ADC8" Padding="1,12,1,20"/><ListBox x:Name="AttentionList" Grid.Row="3" MaxHeight="295"><ListBox.ItemTemplate><DataTemplate><Border Background="#19263B" BorderBrush="#2C3B53" BorderThickness="1" CornerRadius="9" Padding="13,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#D7B56B" CornerRadius="2"/><StackPanel Grid.Column="1" Margin="12,0,8,0"><TextBlock Text="{Binding Message}" FontSize="12"/><TextBlock Text="{Binding TypeLabel}" Foreground="#8BA3C0" FontSize="10" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="Review  &gt;" Foreground="#72CFC7" FontSize="10" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
     </StackPanel>
    </ScrollViewer>
    <Grid x:Name="ReportsView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="0,0,0,17"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ReportSearch" ToolTip="Search scanner, filename, report date, or category"/><Button x:Name="ReviewPendingButton" Grid.Column="2" Content="Show pending reviews"/></Grid><DataGrid x:Name="ReportsGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Scanner" Binding="{Binding ScannerName}" Width="110"/><DataGridTextColumn Header="Report date" Binding="{Binding ReportDate}" Width="100"/><DataGridTextColumn Header="Original filename" Binding="{Binding OriginalFileName}" Width="*"/><DataGridTextColumn Header="Classification" Binding="{Binding CategoryLabel}" Width="200"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0"><Button x:Name="OpenReportButton" Content="Open selected PDF" Margin="0,0,10,0"/><Button x:Name="ReviewReportButton" Content="Review classification"/><TextBlock x:Name="ReportCount" Foreground="#8CA3BF" VerticalAlignment="Center" Margin="16,0,0,0"/></StackPanel></Grid>
    <ScrollViewer x:Name="AdvancedView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Style="{StaticResource Card}" Margin="0,0,0,17"><StackPanel><TextBlock Text="Archive destination" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="The selected location contains your Reports folder, master index, and activity history. Changing it never moves or deletes existing files." Foreground="#8FA8C4" Margin="0,8,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ArchivePath"/><Button x:Name="BrowseArchiveButton" Grid.Column="1" Content="Choose folder" Margin="10,0,0,0"/></Grid><StackPanel Orientation="Horizontal" Margin="0,13,0,0"><Button x:Name="AdoptLegacyButton" Content="Reuse existing v2/v3 archive" Margin="0,0,10,0"/><Button x:Name="OpenLogsButton" Content="Open activity and diagnostics"/></StackPanel></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,17"><StackPanel><TextBlock Text="Scanner connections and classification" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="UNC folders are used directly. Reconnect uses a secure credential prompt only when needed and preserves unrelated drive mappings. Thresholds identify candidates; they never confirm Monthly QA." Foreground="#8FA8C4" Margin="0,8,0,17"/><StackPanel x:Name="ScannerSettingsPanel"/><Button x:Name="ReconnectButton" Content="Reconnect drives" HorizontalAlignment="Left" Margin="0,7,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,17"><StackPanel><TextBlock Text="Coverage and integrity" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Coverage is based on your archive and expected schedule, through yesterday and completed months. Adjust each scanner's active-from date to avoid reporting periods before service began." Foreground="#8FA8C4" Margin="0,8,0,14"/><WrapPanel><StackPanel Width="180" Margin="0,0,18,10"><TextBlock Text="Daily lookback (days)" Foreground="#9BB1CB" Margin="0,0,0,7"/><TextBox x:Name="DailyLookback"/></StackPanel><StackPanel Width="180" Margin="0,0,18,10"><TextBlock Text="Monthly lookback (months)" Foreground="#9BB1CB" Margin="0,0,0,7"/><TextBox x:Name="MonthlyLookback"/></StackPanel><StackPanel Width="180" Margin="0,0,0,10"><TextBlock Text="Minimum PDF age (seconds)" Foreground="#9BB1CB" Margin="0,0,0,7"/><TextBox x:Name="MinimumAge"/></StackPanel></WrapPanel><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><Button x:Name="AuditButton" Content="Run full integrity audit" Margin="0,0,10,0"/><Button x:Name="ReclassifyButton" Content="Review classification overrides"/></StackPanel></StackPanel></Border>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,19"><Button x:Name="SaveSettingsButton" Content="Save advanced settings" Background="#1B5D68" BorderBrush="#2B9B9E" Margin="0,0,12,0"/><TextBlock Text="Settings apply to the next manual operation." Foreground="#8CA4C2" VerticalAlignment="Center"/></StackPanel>
     <TextBlock Text="CT QA Manager Pro 4.0.0   |   Windows PowerShell 5.1 + native WPF" Foreground="#7090B1" FontSize="11"/><TextBlock Text="No scheduled monitoring. No passwords saved. Original scanner reports are always read-only. Use under your department's approved access and records policy." Foreground="#7090B1" FontSize="11" Margin="0,6,0,15"/>
    </StackPanel></ScrollViewer>
   </Grid>
   <Border Grid.Row="2" Background="#101B2D" BorderBrush="#22334B" BorderThickness="1" CornerRadius="10" Padding="15,11" Margin="0,17,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Ready. Choose First-Time Setup to begin." Foreground="#9FB4CF" VerticalAlignment="Center" FontSize="11"/><Button x:Name="CancelButton" Grid.Column="1" Content="Cancel safely" Visibility="Collapsed" Padding="11,5" Margin="12,0,0,0"/></Grid><ProgressBar x:Name="WorkProgress" Grid.Row="1" Visibility="Collapsed" Height="3" Margin="0,10,0,0" Minimum="0" Maximum="100" Foreground="#33D6C5" Background="#20334C" BorderThickness="0"/></Grid></Border>
  </Grid>
 </Grid>
</Window>
