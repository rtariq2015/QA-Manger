<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Review saved QA reports" Width="1240" Height="820" MinWidth="860" MinHeight="580" Background="#0B1120" Foreground="#EAF0FC" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock TextWrapping="Wrap" Text="Review one PDF at a time" FontSize="24" FontWeight="SemiBold"/><TextBlock TextWrapping="Wrap" x:Name="QueueReportTitle" Foreground="#A5C3D6" Margin="0,7,15,0"/><TextBlock TextWrapping="Wrap" x:Name="QueueProgress" Foreground="#71D7C8" FontSize="11" Margin="0,6,0,0"/></StackPanel><Button x:Name="QueueClose" Grid.Column="1" Content="Back to reports" VerticalAlignment="Top" Padding="12,8"/></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
   <Border Background="#162235" BorderBrush="#2C415B" BorderThickness="1" CornerRadius="12" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,10"><Button x:Name="PreviousPage" Content="Previous page" Padding="10,6" Margin="0,0,7,5"/><Button x:Name="NextPage" Content="Next page" Padding="10,6" Margin="0,0,10,5"/><TextBlock TextWrapping="Wrap" x:Name="PageStatus" Text="Preview" Foreground="#B3CBDE" VerticalAlignment="Center" Margin="0,0,10,5"/><ComboBox x:Name="PreviewZoom" Width="85" Margin="0,0,8,5"/><Button x:Name="QueueOpenPdf" Content="Open PDF viewer" Padding="10,6" Margin="0,0,0,5"/></WrapPanel>
    <Grid Grid.Row="1"><ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#293546"><Image x:Name="QueuePageImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top"/></ScrollViewer><Border x:Name="PreviewMessagePanel" Background="#162235" Padding="25"><StackPanel VerticalAlignment="Center"><TextBlock TextWrapping="Wrap" x:Name="PreviewMessage" Text="Loading the saved PDF..." FontSize="17" TextAlignment="Center"/><TextBlock TextWrapping="Wrap" Text="If the built-in preview is unavailable, use Open PDF viewer. Your saved file stays unchanged." Foreground="#8EAFC5" TextAlignment="Center" Margin="0,12,0,0"/></StackPanel></Border></Grid>
   </Grid></Border>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border Background="#142C37" CornerRadius="10" Padding="15" Margin="0,0,0,13"><StackPanel><TextBlock TextWrapping="Wrap" x:Name="QueueStatus" Text="Pending verification" Foreground="#E5C17A" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="QueueWhyPending" TextWrapping="Wrap" Foreground="#C7DBE7" FontSize="11" Margin="0,8,0,0"/><TextBlock TextWrapping="Wrap" Text="Accept confirms this PDF's report type. Monthly completion uses only the department checklist items you explicitly select." Foreground="#A7C4D3" FontSize="11" Margin="0,9,0,0"/></StackPanel></Border>
    <TextBlock TextWrapping="Wrap" Text="Reviewer name / approved ID" Foreground="#A5C0D3" Margin="0,0,0,6"/><TextBox x:Name="QueueReviewer"/>
    <CheckBox x:Name="QueueAuthorized" Margin="0,10,0,13"><TextBlock Text="I am authorized to review these report types." TextWrapping="Wrap"/></CheckBox>
    <TextBlock TextWrapping="Wrap" Text="Accept this PDF as" Foreground="#A5C0D3" Margin="0,0,0,6"/><ComboBox x:Name="QueueType" DisplayMemberPath="Label" SelectedValuePath="Value"/>
    <StackPanel x:Name="QueueChecklistPanel" Margin="0,15,0,0"><TextBlock TextWrapping="Wrap" Text="Which monthly items are documented?" FontWeight="SemiBold"/><TextBlock TextWrapping="Wrap" x:Name="QueueChecklistNote" Foreground="#A4BFD0" FontSize="11" Margin="0,7,0,9"/><StackPanel x:Name="QueueComponents"/><Button x:Name="QueueSelectAll" Content="All listed items are documented" Padding="8,6" Margin="0,9,0,0" FontSize="11"/></StackPanel>
    <TextBlock TextWrapping="Wrap" Text="Clicking Accept or Decline records that you inspected this PDF. No printed PASS/FAIL result is inferred from this decision." Foreground="#8EAEC3" FontSize="11" Margin="0,17,0,14"/>
   </StackPanel></ScrollViewer><StackPanel Grid.Row="1" Margin="0,12,0,0">
    <Button x:Name="QueueAccept" Content="Accept report type" Background="#1A685D" BorderBrush="#359E8E" Margin="0,0,0,9" IsEnabled="False"/>
    <Button x:Name="QueueDecline" Content="Decline suggestion..." Background="#3E3540" BorderBrush="#796773" Margin="0,0,0,9" IsEnabled="False"/>
    <Button x:Name="QueueSkip" Content="Skip for now / next PDF" Margin="0,0,0,9"/>
    <Button x:Name="QueueUndo" Content="Undo last decision" Background="Transparent" IsEnabled="False"/>
    <TextBlock TextWrapping="Wrap" Text="Ctrl+Enter: accept   Ctrl+D: decline" Foreground="#789DB4" FontSize="10" Margin="0,14,0,0"/>
   </StackPanel></Grid>
  </Grid>
  <Border Grid.Row="2" Background="#111E30" CornerRadius="9" Padding="13" Margin="0,14,0,0"><StackPanel><TextBlock TextWrapping="Wrap" x:Name="QueueMessage" Text="Inspect the PDF, choose its type, then accept or decline. Skipping leaves it pending." Foreground="#B5CEDF"/><TextBlock TextWrapping="Wrap" Text="PDFs and decision history are preserved. The readable folder view refreshes once when you finish this review session." Foreground="#789CB5" FontSize="10" Margin="0,7,0,0"/></StackPanel></Border>
 </Grid>
</Window>
